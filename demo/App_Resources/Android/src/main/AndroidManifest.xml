<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools" package="__PACKAGE__">
  <uses-permission android:name="android.permission.INTERNET" />
  <application
    android:name="com.tns.NativeScriptApplication"
    android:allowBackup="false"
    tools:replace="android:allowBackup"
    android:label="NativeScript Preact"
    android:theme="@style/AppTheme"
    android:hardwareAccelerated="true">
    <activity
      android:name="com.tns.NativeScriptActivity"
      android:label="NativeScript Preact"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|locale|uiMode"
      android:launchMode="singleTask"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <activity android:name="com.tns.ErrorReportActivity" android:exported="false" />
  </application>
</manifest>
